#!name = 小羊网络场景
#!desc = v2.2.0 · 按 Wi-Fi 切换模式。支持暂停全部或当前 Wi-Fi 的自动切换。
#!author = 小羊
#!system = iOS,iPadOS
#!system_version = 15.0
#!loon_version = 3.5.1(986)
#!tag = 网络,自动化,场景
#!type = normal

[Argument]
pause_auto = switch,false,tag=暂停自动切换,desc="打开后可以手动切模式。需要继续自动切换时，关闭这个开关。"
trusted_ssids = input,"YXC",tag=全局直连的 Wi-Fi,desc="只填 Wi-Fi 名称。多个用逗号分开。"
rule_ssids = input,"",tag=规则模式的 Wi-Fi,desc="只填 Wi-Fi 名称。多个用逗号分开。"
proxy_ssids = input,"",tag=全局代理的 Wi-Fi,desc="只填 Wi-Fi 名称。多个用逗号分开。"
leave_mode = select,RULE,PREVIOUS,PROXY,tag=离开后的模式,desc="RULE 回规则模式；PREVIOUS 回接管前的模式；PROXY 回全局代理。"
notifications = switch,true,tag=显示切换通知,desc="关闭后自动切换不发通知，手动操作仍显示结果。"

[Script]
network-changed then script("https://raw.githubusercontent.com/a1286871907/Loon-plugin/refs/heads/main/XiaoyangNetworkScene.js?v=220", {${pause_auto}, ${trusted_ssids}, ${rule_ssids}, ${proxy_ssids}, ${leave_mode}, ${notifications}}) with tag="小羊网络场景", timeout=15
generic then script("https://raw.githubusercontent.com/a1286871907/Loon-plugin/refs/heads/main/XiaoyangNetworkScene.js?v=220", {${pause_auto}, ${trusted_ssids}, ${rule_ssids}, ${proxy_ssids}, ${leave_mode}, ${notifications}}) with tag="暂停或恢复当前 Wi-Fi", timeout=15, img_url="pause.circle.system"
generic then script("https://raw.githubusercontent.com/a1286871907/Loon-plugin/refs/heads/main/XiaoyangNetworkScene.js?v=220", {${pause_auto}, ${trusted_ssids}, ${rule_ssids}, ${proxy_ssids}, ${leave_mode}, ${notifications}}) with tag="立即应用当前网络场景", timeout=15, img_url="wifi.system"
generic then script("https://raw.githubusercontent.com/a1286871907/Loon-plugin/refs/heads/main/XiaoyangNetworkScene.js?v=220", {${pause_auto}, ${trusted_ssids}, ${rule_ssids}, ${proxy_ssids}, ${leave_mode}, ${notifications}}) with tag="查看当前网络场景", timeout=15, img_url="info.circle.system"
